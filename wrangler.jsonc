/**
 * DB and BUCKET intentionally omit resource names and IDs. Wrangler and the
 * Deploy to Cloudflare flow auto-provision isolated resources for each user.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screendrop-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "secrets": {
    "required": ["UPLOAD_TOKEN"]
  }
}
