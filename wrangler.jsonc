/**
 * DB and BUCKET intentionally omit resource names and IDs. Wrangler and the
 * Deploy to Cloudflare flow auto-provision isolated resources for each user.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screendrop-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "upload_source_maps": true,
  "secrets": {
    "required": ["UPLOAD_TOKEN"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "R2_BUDGET", "class_name": "R2Budget" }],
  },
  "migrations": [{ "tag": "r2-budget-v1", "new_sqlite_classes": ["R2Budget"] }],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "LIBRARY_LOGIN_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "R2_DAILY_READ_LIMIT": "10000",
    "R2_MONTHLY_READ_LIMIT": "300000",
    "CACHE_TTL_SECONDS": "300",
    "RATE_LIMIT_RETRY_AFTER": "60",
    "R2_BUDGET_RETRY_AFTER": "60",
  },
}
